{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "kitty",
        "source": "/home/samsepi0l/.config/fastfetch/arch-linux.png",
        "width": 40,
        "height": 15,
        "padding": {
            "top": 1,
            "left": 1,
            "right": 2
        }
    },

    "display": {
        "separator": "  "
    },

    "modules": [
        {
            "type": "custom",
            "format": "\u001b[1;35m󰣇 SYSTEM\u001b[0m"
        },
        {
            "type": "os",
            "key": "\u001b[35m├ 󰣇 OS\u001b[0m"
        },
        {
            "type": "kernel",
            "key": "\u001b[35m├  KERNEL\u001b[0m"
        },
        {
            "type": "uptime",
            "key": "\u001b[35m├ 󰅐 UPTIME\u001b[0m"
        },
        {
            "type": "packages",
            "key": "\u001b[35m└ 󰏖 PACKAGES\u001b[0m"
        },

        {
            "type": "custom",
            "format": "\u001b[1;34m󰍛 HARDWARE\u001b[0m"
        },
        {
            "type": "cpu",
            "key": "\u001b[34m├ 󰻠 CPU\u001b[0m",
                "format": "{name}"
        },
        {
            "type": "memory",
            "key": "\u001b[34m├  RAM\u001b[0m",
                "format": "{used} / {total}"
        },
        {
            "type": "disk",
            "key": "\u001b[34m└ 󰋊 DISK\u001b[0m",
                "format": "{size-used} / {size-total}"
        },

        {
            "type": "custom",
            "format": "\u001b[1;36m SESSION\u001b[0m"
        },
        {
            "type": "shell",
            "key": "\u001b[36m├ 󰆍 SHELL\u001b[0m"
        },
        {
            "type": "terminal",
            "key": "\u001b[36m├  TERM\u001b[0m"
        },
        {
            "type": "localip",
            "key": "\u001b[36m└ 󰩟 IP\u001b[0m"
        }
            ]
}
