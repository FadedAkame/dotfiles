{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 0,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": ["group/system"],
    "modules-center": ["clock"],
    "modules-right": ["group/right"],

    "group/system": {
        "orientation": "horizontal",
        "modules": ["cpu", "custom/gpu", "memory"]
    },
    "group/right": {
        "orientation": "horizontal",
        "modules": ["pulseaudio", "custom/power"]
    },

    "cpu": {
        "format": "CPU: {usage}%",
        "interval": 2,
        "tooltip": false
    },
    "custom/gpu": {
        "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
        "format": "GPU: {}%",
        "interval": 2,
        "tooltip": false
    },
    "memory": {
        "format": "RAM: {}%",
        "interval": 2,
        "tooltip": false
    },

    "clock": {
        "format": "{:%H:%M}",
        "interval": 10,
        "tooltip": false
    },

    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰝟 muted",
        "scroll-step": 5,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "tooltip": false
    },
    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Left click: Reboot\nRight click: Shutdown",
        "on-click": "systemctl reboot",
        "on-click-right": "systemctl poweroff"
    }
}
